{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe"
    }
  },
  "tasks": [
    {
      "type": "cppbuild",
      "label": "g++.exe build active file",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "${file}",
        "-D_GLIBCXX_DEBUG",
        "-I",
        "${workspaceFolder}",
        "-O2",
        "-Wall",
        "-Wconversion",
        "-Wextra",
        "-Wfloat-equal",
        "-Wshadow",
        "-fdiagnostics-color=always",
        "-g",
        "-o",
        "${workspaceFolder}\\debug.exe",
        "-std=c++23"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "shared",
        "clear": true
      }
    },
    {
      "type": "shell",
      "label": "remove output file",
      "command": "if (Test-Path ${workspaceFolder}\\debug.exe) { Remove-Item ${workspaceFolder}\\debug.exe }",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "shared",
        "reveal": "never",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "bundle and copy",
      "command": "cmd /c oj-bundle ${file} -I ${workspaceFolder} > submit.cpp; (Get-Content submit.cpp -Raw) -replace '(?s)(cerr|std::cerr).*?;', ';' | Set-Clipboard; Remove-Item submit.cpp",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "shared",
        "clear": true,
        "close": true
      }
    },
    // template
    {
      "type": "shell",
      "label": "create file using template",
      "command": "Get-Content ${workspaceFolder}\\template\\template.cpp | Set-Content ${input:filename}",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "panel": "shared",
        "reveal": "never",
        "close": true
      }
    }
  ],
  "inputs": [
    {
      "id": "filename",
      "type": "promptString",
      "description": "enter file name"
    }
  ]
}